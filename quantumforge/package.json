{
  "name": "quantumforge-server",
  "version": "1.0.0",
  "private": true,
  "description": "QuantumForge backend: Express API, WebSockets, MongoDB, Redis, Elasticsearch, Quantum integrations",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development nodemon server/server.js",
    "start": "node server/server.js",
    "test": "jest --runInBand --coverage",
    "lint": "echo 'no linter configured'",
    "postinstall": "cd client && npm install"
  },
  "dependencies": {
    "@elastic/elasticsearch": "8.15.0",
    "@sentry/node": "7.118.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "express-rate-limit": "7.4.0",
    "helmet": "7.1.0",
    "http": "0.0.1-security",
    "isomorphic-git": "1.25.7",
    "jsonschema": "1.4.1",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.5.2",
    "multer": "1.4.5-lts.1",
    "nodemailer": "6.9.14",
    "socket.io": "4.7.5",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "20.14.11",
    "jest": "29.7.0",
    "mongodb-memory-server": "10.1.4",
    "nodemon": "3.1.4",
    "supertest": "7.0.0"
  }
}